# Clé d'API OpenRouter (https://openrouter.ai/settings/keys).
# Copiez ce fichier en .env : il est ignoré par git et ne doit jamais être committé.
OPENROUTER_API_KEY=

# Modèle utilisé par les agents. openrouter/auto laisse le routeur automatique
# d'OpenRouter choisir un modèle pour chaque requête. Un modèle fixe doit
# accepter les appels d'outils (tool calling), sinon chaque échange échoue.
OPENROUTER_MODEL=openrouter/auto
